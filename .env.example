# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
# Supabase PostgreSQL connection string. Use the transaction pooler for the app.
DATABASE_URL=             # postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
